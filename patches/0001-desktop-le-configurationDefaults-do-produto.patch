index 43e145eb3b7..430cf8fadeb 100644
--- a/src/vs/base/common/product.ts
+++ b/src/vs/base/common/product.ts
@@ -121,9 +121,52 @@ export interface IProductConfiguration {
 	readonly sharedDataFolderName: string; // location for shared data (e.g. ~/.vscode-insiders-shared)
 
 	readonly builtInExtensions?: IBuiltInExtension[];
+	/**
+	 * Drop the walkthroughs that ship inside the workbench source.
+	 *
+	 * A product built from this source is not Visual Studio Code, and the built-in
+	 * walkthroughs name it on screen ("Get started with VS Code"), advertise features
+	 * this build does not ship, and cannot be turned off by configuration. A product
+	 * that brings its own welcome walkthrough sets this to `true`; everything a product
+	 * or an extension contributes keeps working.
+	 */
+	readonly hideBuiltinWalkthroughs?: boolean;
+
 	readonly walkthroughMetadata?: IProductWalkthrough[];
 	readonly featuredExtensions?: IFeaturedExtension[];
 
+	/**
+	 * Default values for settings, shipped with the product.
+	 *
+	 * The web embedder already accepts these through
+	 * `IWorkbenchConstructionOptions.configurationDefaults`; this makes the same
+	 * overrides available to a desktop build, which has no embedder to provide them.
+	 * They are registered as DEFAULTS: user, workspace and policy settings still win.
+	 */
+	readonly configurationDefaults?: IStringDictionary<unknown>;
+
+	/**
+	 * View containers that start UNPINNED the first time they appear in a composite bar.
+	 *
+	 * There is no setting for which icons the activity bar shows out of the box: a
+	 * container that registers without saved state is always pinned. A product that
+	 * wants a shorter bar lists the ids here. Only the very first registration without
+	 * saved state is affected; once the bar has stored a state for a container (the user
+	 * pinned it, or the default was saved), that state wins, and moving a container
+	 * between locations keeps the upstream behaviour.
+	 */
+	readonly defaultUnpinnedViewContainers?: readonly string[];
+
+	/**
+	 * The folder, under the platform's application data directory, where this build keeps the user's
+	 * data (settings, layout, workbench storage). Defaults to `nameShort`.
+	 *
+	 * A product that ships in two editions built from the same source — one public, one private — can
+	 * keep their data apart with this key alone, instead of renaming the whole product for one of them:
+	 * `nameShort` also names the executable and appears on screen. See patches/0015.
+	 */
+	readonly userDataFolderName?: string;
+
 	readonly downloadUrl?: string;
 	readonly updateUrl?: string;
 	readonly webUrl?: string;
