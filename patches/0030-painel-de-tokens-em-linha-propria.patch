+ * published), a JSON array of strings (steps), and a JSON object `{ degraus, botoes }`. A product
+ * that has not been updated keeps working, and nothing here throws: this runs on every context
+ * change, and a bad value must not be able to break the workbench.
+ */
+export function oficinaLerRotulo(valor: unknown): IOficinaRotulo {
+	const vazio: IOficinaRotulo = { degraus: [], botoes: [] };
+	if (Array.isArray(valor)) {
+		return { degraus: textos(valor), botoes: [] };
+	}
+	if (typeof valor !== 'string' || !valor) {
+		return vazio;
+	}
+	const cru = valor.trim();
+	if (cru.startsWith('[') || cru.startsWith('{')) {
+		try {
+			const lido = JSON.parse(cru);
+			if (Array.isArray(lido)) {
+				const degraus = textos(lido);
+				if (degraus.length) {
+					return { degraus, botoes: [] };
+				}
+			} else if (lido && typeof lido === 'object') {
+				const o = lido as { degraus?: unknown; botoes?: unknown };
+				const degraus = textos(o.degraus);
+				if (degraus.length) {
+					return { degraus, botoes: lerBotoes(o.botoes) };
+				}
+			}
+		} catch {
+			// Not JSON after all: treat it as the plain text it looks like.
+		}
+	}
+	return { degraus: [valor], botoes: [] };
+}
