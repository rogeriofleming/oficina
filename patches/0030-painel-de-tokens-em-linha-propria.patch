+export interface IOficinaRotulo {
+	readonly degraus: string[];
+	readonly botoes: IOficinaBotaoDoRotulo[];
+}
+
+/** Only a codicon id — never a selector. What the product writes here is drawn as a CSS class. */
+const PADRAO_DO_ICONE = /^[a-z0-9-]+$/;
