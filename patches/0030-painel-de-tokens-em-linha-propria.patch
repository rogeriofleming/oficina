+ *--------------------------------------------------------------------------------------------*/
+
+/**
+ * OFICINA patch 0030: the live label, drawn in coloured pieces — shared by the two hosts.
+ *
+ * Patch 0029 taught the TITLE BAR to draw the live token label in pieces, each with the colour of
+ * the floating token panel the owner uses. Patch 0030 gives that label a row of its own (the
+ * banner), and the two must look the same — so the drawing moved here instead of being copied.
+ * A copy would drift: the first colour changed in one host and not in the other is a defect the
+ * owner would see instantly, since the whole point of 0029 was "the same as my panel".
+ *
+ * Nothing here knows what the text MEANS. It cuts the text on the separators whoever writes it
+ * already uses (` │ ` between items, two spaces between the parts of one item) and colours each
+ * piece BY FORMAT. Text with no separator comes out as a single piece with the name colour.
+ *
+ * ⚠️ THE SPACES STAY IN THE TEXT, not in margins. The first version of 0029 separated the pieces
+ * with `margin`, and the label's `textContent` became `nome$1.2469.6k` — which is what a screen
+ * reader and copy/paste get, and what the regression suite reads. With `white-space: pre` the two
+ * spaces show as they are, and the element's text is EXACTLY what was written.
+ *
+ * ⚠️ The colours are the panel's, and the panel is dark. On a light theme they would be washed out;
+ * OFICINA has only a dark theme today, and this is said here for when it has another.
+ */
+
+const COR_DO_NOME = '#a8afb9';
+const COR_DO_VALOR = '#f2f4f6';
+const COR_DOS_TOKENS = '#949ba6';
+const COR_DO_RISCO = 'rgba(255, 255, 255, 0.28)';
+
+/** A number with an optional `k`/`M`, alone or as `agora/total` — the token counts. */
+const PADRAO_DOS_TOKENS = /^[\d.,]+[kM]?(\/[\d.,]+[kM]?)?$/;
+
+export function oficinaDesenharEmPedacos(alvo: HTMLElement, texto: string): void {
+	alvo.textContent = '';
+	alvo.style.whiteSpace = 'pre';
+	const doc = alvo.ownerDocument;
+	const itens = texto.split(' │ ');
+	itens.forEach((item, i) => {
+		if (i > 0) {
+			const risco = doc.createElement('span');
+			risco.textContent = ' │ ';
+			risco.style.color = COR_DO_RISCO;
+			alvo.appendChild(risco);
+		}
+		item.split(/( {2,})/).forEach(parte => {
+			if (!parte) {
+				return;
+			}
+			if (!parte.trim()) {
+				alvo.appendChild(doc.createTextNode(parte));
+				return;
+			}
+			const pedaco = doc.createElement('span');
+			pedaco.textContent = parte;
+			if (/^\$/.test(parte.trim())) {
+				pedaco.style.color = COR_DO_VALOR;
+				pedaco.style.fontWeight = '600';
+			} else if (PADRAO_DOS_TOKENS.test(parte.trim())) {
+				pedaco.style.color = COR_DOS_TOKENS;
+				pedaco.style.fontSize = '0.9em';
+			} else {
+				pedaco.style.color = COR_DO_NOME;
+			}
+			alvo.appendChild(pedaco);
+		});
+	});
+}
+
+/**
+ * What the product publishes in the live-label key: either one text, or a LIST of texts from the
+ * fullest to the tightest, for the host to pick the widest one that fits.
+ *
+ * ⚠️ WHY A LIST, AND NOT A CHARACTER LIMIT. Until patch 0030 the extension guessed how much fitted
+ * by counting characters against a width it could not see (`LIMITE_DA_LINHA = 78`, derived from the
+ * `30vw` cap of patch 0023). A guess like that is wrong twice: it wastes room on a wide window and
+ * overflows on a narrow one, and it goes stale the day the cap or the screen changes — which is
+ * exactly what the owner ran into. Now the EXTENSION owns the policy (what gives way first: the
+ * total, then the sum, then the name) and the HOST owns the measuring, because only it knows the
+ * width. Neither has to know the other's half.
+ */
+export type OficinaTextoVivo = string | string[];
+
+/**
+ * Picks, among `degraus`, the first whose drawn width fits `largura`, measuring for real.
+ *
+ * Measuring beats estimating here: the label's font, letter spacing and the `0.9em` of the token
+ * pieces are all in the CSS, and any arithmetic over character counts would have to guess them.
+ *
+ * @param medir draws a candidate and answers how wide it came out
+ * @returns the chosen text — the last one when none fits, so there is always something to draw
+ */
+export function oficinaEscolherDegrau(degraus: string[], largura: number, medir: (texto: string) => number): string {
+	for (const degrau of degraus) {
+		if (medir(degrau) <= largura) {
+			return degrau;
+		}
+	}
+	return degraus[degraus.length - 1];
+}
+
+/** A button the product asks the banner to draw next to the label. */
+export interface IOficinaBotaoDoRotulo {
+	readonly comando: string;
+	/** A codicon id, e.g. `graph`. Anything else is ignored rather than injected as a selector. */
+	readonly icone: string;
+	readonly dica: string;
+}
