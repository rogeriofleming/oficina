+function lerBotoes(valor: unknown): IOficinaBotaoDoRotulo[] {
+	if (!Array.isArray(valor)) {
+		return [];
+	}
+	const botoes: IOficinaBotaoDoRotulo[] = [];
+	for (const b of valor) {
+		if (!b || typeof b !== 'object') {
+			continue;
+		}
+		const { comando, icone, dica } = b as { comando?: unknown; icone?: unknown; dica?: unknown };
+		if (typeof comando !== 'string' || !comando) {
+			continue;
+		}
+		if (typeof icone !== 'string' || !PADRAO_DO_ICONE.test(icone)) {
+			continue;
+		}
+		botoes.push({ comando, icone, dica: typeof dica === 'string' ? dica : '' });
+	}
