diff --git a/src/vs/workbench/browser/parts/banner/media/bannerpart.css b/src/vs/workbench/browser/parts/banner/media/bannerpart.css
index a0de81f24eb..640da41bf9b 100644
--- a/src/vs/workbench/browser/parts/banner/media/bannerpart.css
+++ b/src/vs/workbench/browser/parts/banner/media/bannerpart.css
@@ -78,3 +78,99 @@
 .monaco-workbench .part.banner .action-container .codicon {
 	color: var(--vscode-banner-foreground);
 }
+
+/* ── GAUGES (OFICINA patch 0017) ────────────────────────────────────────────
+ *
+ * A row of small meters drawn in the banner strip instead of a message. The core does not
+ * know what they measure — it draws a label, a bar filled to a percentage, and the number.
+ *
+ * Colours come from tokens that already exist, so any theme gets a sane result without having
+ * to learn new keys: the track is the banner foreground at low opacity, the fill is the
+ * progress bar colour.
+ */
+
+.monaco-workbench .part.banner .gauges-container {
+	display: flex;
+	flex-direction: row;
+	align-items: center;
+	gap: 18px;
+	padding: 0 12px;
+	width: 100%;
+	height: 26px;
+	overflow: hidden;
+}
+
+.monaco-workbench .part.banner .gauges-expand {
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	flex-shrink: 0;
+	width: 20px;
+	height: 20px;
+	border-radius: 4px;
+	color: var(--vscode-banner-foreground);
+	cursor: pointer;
+}
+
+.monaco-workbench .part.banner .gauges-expand:hover {
+	background-color: var(--vscode-toolbar-hoverBackground);
+}
+
+.monaco-workbench .part.banner .gauges-expand:focus-visible {
+	outline: 1px solid var(--vscode-focusBorder);
+	outline-offset: -1px;
+}
+
+.monaco-workbench .part.banner .gauge {
+	display: flex;
+	flex-direction: row;
+	align-items: center;
+	gap: 6px;
+	flex-shrink: 0;
+}
+
+.monaco-workbench .part.banner .gauge-label {
+	letter-spacing: .02em;
+	white-space: nowrap;
+}
+
+/* The track never grows past its share of the strip: with a narrow window the bars shrink,
+   and the label and the number — which are what you actually read — stay legible.
+   ⚠️ THE DIM PART IS A PSEUDO-ELEMENT, NOT `opacity` ON THE TRACK. `opacity` applies to the whole
+   subtree, so it would also dim the fill inside — measured in a headless browser, the "used" part
+   came out darker than the "unused" one: [79,57,40] against [80,80,80]. The bar read backwards.
+   A pseudo-element dims only the background, and the fill keeps its own colour. `color-mix` would
+   also work and is shorter, but it needs a newer engine than this file can assume. */
+.monaco-workbench .part.banner .gauge-track {
+	position: relative;
+	width: 90px;
+	min-width: 28px;
+	height: 6px;
+	border-radius: 3px;
+	overflow: hidden;
+	flex-shrink: 1;
+}
+
+.monaco-workbench .part.banner .gauge-track::before {
+	content: '';
+	position: absolute;
+	inset: 0;
+	background-color: var(--vscode-banner-foreground);
+	opacity: 0.22;
+}
+
+.monaco-workbench .part.banner .gauge-fill {
+	position: relative;
+	height: 100%;
+	border-radius: 3px;
+	background-color: var(--vscode-progressBar-background);
+	/* The width comes from the percentage, set inline. A transition would animate a number that
+	   only changes every few minutes — it would read as the bar "drifting" on its own. */
+}
+
+.monaco-workbench .part.banner .gauge-value {
+	min-width: 34px;
+	text-align: right;
+	font-variant-numeric: tabular-nums;
+	white-space: nowrap;
+}
