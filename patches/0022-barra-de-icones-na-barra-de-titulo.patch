+   ───────────────────────────────────────────────────────────────────────────────────────── */
+.monaco-workbench .part.titlebar > .titlebar-container > .titlebar-left > .titlebar-activity-container .monaco-action-bar .action-item.icon {
+	display: flex;
+	align-items: center;
+	padding: 0 3px;
+}
+
+.monaco-workbench .part.titlebar > .titlebar-container > .titlebar-left > .titlebar-activity-container .monaco-action-bar .action-item.icon .action-label:not(.codicon) {
+	width: 16px;
+	height: 16px;
+	background-size: 16px;
+	background-repeat: no-repeat;
+	background-position: center center;
+}
