 	private get activityActionsEnabled(): boolean {
+		// A product that hides the global activity actions (see `hideActivityBarGlobalActions`) means it
+		// everywhere, not only on the activity bar. Without this, moving the activity bar to the top or
+		// bottom brings Accounts and Manage back through the title bar — the product asked for them to be
+		// gone and they returned by a different door, which is worse than never having hidden them.
+		if (this.productService.hideActivityBarGlobalActions) {
+			return false;
+		}
+
 		const activityBarPosition = this.configurationService.getValue<ActivityBarPosition>(LayoutSettings.ACTIVITY_BAR_LOCATION);
 		return !this.isCompact && !this.isAuxiliary && (activityBarPosition === ActivityBarPosition.TOP || activityBarPosition === ActivityBarPosition.BOTTOM);
 	}
