+
+/* Os medidores em si: o mesmo desenho da faixa (patch 0017), compacto — barrinhas 10% menores
+   (90 -> 81 px) e o vao entre os dois apertado (18 -> 12 px), como aprovado. Sem `no-drag` nos
+   medidores: eles continuam sendo alca para arrastar a janela; so o botao de expandir nao e. */
+.monaco-workbench .part.titlebar .titlebar-gauges {
+	display: flex;
+	align-items: center;
+	height: 100%;
+	flex-shrink: 0;
+}
+
+.monaco-workbench .part.titlebar .titlebar-gauges .gauges-container {
+	display: flex;
+	flex-direction: row;
+	align-items: center;
+	gap: 12px;
+	padding: 0 8px;
+	height: 100%;
+	color: var(--vscode-titleBar-activeForeground);
+}
+
+.monaco-workbench .part.titlebar .titlebar-gauges .gauges-expand {
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	flex-shrink: 0;
+	width: 20px;
+	height: 20px;
+	border-radius: 4px;
+	cursor: pointer;
+	-webkit-app-region: no-drag;
+}
+
+.monaco-workbench .part.titlebar .titlebar-gauges .gauges-expand:hover {
+	background-color: var(--vscode-toolbar-hoverBackground);
+}
+
+.monaco-workbench .part.titlebar .titlebar-gauges .gauges-expand:focus-visible {
+	outline: 1px solid var(--vscode-focusBorder);
+	outline-offset: -1px;
+}
+
+.monaco-workbench .part.titlebar .titlebar-gauges .gauge {
+	display: flex;
+	flex-direction: row;
+	align-items: center;
+	gap: 6px;
+	flex-shrink: 0;
+}
+
+.monaco-workbench .part.titlebar .titlebar-gauges .gauge-label {
+	letter-spacing: .02em;
+	white-space: nowrap;
+}
+
+/* A parte apagada e pseudo-elemento, e nao `opacity` no trilho: `opacity` apagaria tambem o
+   preenchimento, e a barra leria ao contrario (medido no 0017). */
+.monaco-workbench .part.titlebar .titlebar-gauges .gauge-track {
+	position: relative;
+	width: 81px;
+	height: 6px;
+	border-radius: 3px;
+	overflow: hidden;
+	flex-shrink: 0;
+}
+
+.monaco-workbench .part.titlebar .titlebar-gauges .gauge-track::before {
+	content: '';
+	position: absolute;
+	inset: 0;
+	background-color: var(--vscode-titleBar-activeForeground);
+	opacity: 0.22;
+}
+
+.monaco-workbench .part.titlebar .titlebar-gauges .gauge-fill {
+	position: relative;
+	height: 100%;
+	border-radius: 3px;
+	background-color: var(--vscode-progressBar-background);
+}
+
+.monaco-workbench .part.titlebar .titlebar-gauges .gauge-value {
+	min-width: 34px;
+	text-align: right;
+	font-variant-numeric: tabular-nums;
+	white-space: nowrap;
+}
