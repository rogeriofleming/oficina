diff --git a/src/vs/workbench/browser/parts/banner/gaugesSlot.ts b/src/vs/workbench/browser/parts/banner/gaugesSlot.ts
new file mode 100644
index 00000000000..e2c3b9b24db
--- /dev/null
+++ b/src/vs/workbench/browser/parts/banner/gaugesSlot.ts
@@ -0,0 +1,68 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Emitter, Event } from '../../../../base/common/event.js';
+
+/**
+ * OFICINA patch 0028: where the banner gauges are drawn.
+ *
+ * The banner draws the gauges (patch 0017). When the product asks for it (`titleBarGauges`), the
+ * title bar offers a slot for them — and only while there is room: it takes the slot back when the
+ * window gets too narrow, and the gauges return to the banner row by themselves.
+ *
+ * One renderer, two hosts. The title bar never draws a gauge; it only says "here, if it fits".
+ * A module-level singleton because the two parts do not know each other, and the title bar of an
+ * auxiliary window never offers a slot (there is no banner there).
+ */
+class GaugesSlot {
+	private _element: HTMLElement | undefined;
+	private readonly _onDidChange = new Emitter<void>();
+	readonly onDidChange: Event<void> = this._onDidChange.event;
+
+	get element(): HTMLElement | undefined {
+		return this._element;
+	}
+
+	set(element: HTMLElement | undefined): void {
+		if (element !== this._element) {
+			this._element = element;
+			this._onDidChange.fire();
+		}
+	}
+
+	/**
+	 * The banner redrew the gauges inside the slot. Their width may have changed (a third gauge, a
+	 * longer label), and only the title bar can say whether they still fit — it listens to this.
+	 */
+	private readonly _onDidRender = new Emitter<void>();
+	readonly onDidRender: Event<void> = this._onDidRender.event;
+
+	notifyRendered(): void {
+		this._onDidRender.fire();
+	}
+
+	/**
+	 * Whether the banner has any gauge to draw — told by the banner on every update, whoever hosts the
+	 * gauges. The title bar offers the slot only when this is true: offering it for an empty list moved
+	 * the search out of the centre and shrank it for nothing (measured 25/09/2026, a profile with no
+	 * gauges: the class on, the search at 147 px, the slot empty).
+	 */
+	private _temMedidores = false;
+	private readonly _onDidChangeTemMedidores = new Emitter<void>();
+	readonly onDidChangeTemMedidores: Event<void> = this._onDidChangeTemMedidores.event;
+
+	get temMedidores(): boolean {
+		return this._temMedidores;
+	}
+
+	setTemMedidores(tem: boolean): void {
+		if (tem !== this._temMedidores) {
+			this._temMedidores = tem;
+			this._onDidChangeTemMedidores.fire();
+		}
+	}
+}
+
+export const titleBarGaugesSlot = new GaugesSlot();
