+	/**
+	 * Drops the command ids the product asked to hide from the tab bar (OFICINA patch 0019).
+	 *
+	 * The core does not know what those ids mean: the list comes from `editorTitleActionsToHide`.
+	 * Both the visible row and the overflow are filtered, so the "…" button goes away once nothing
+	 * is left behind it — hiding the icons but keeping their menu would only move the clutter.
+	 */
+	private semAsEscondidasPeloProduto(actions: IToolbarActions): IToolbarActions {
+		const esconder = this.productService.editorTitleActionsToHide;
+		if (!esconder?.length) {
+			return actions;
+		}
+
+		const fora = new Set(esconder);
+		return {
+			primary: actions.primary.filter(a => !fora.has(a.id)),
+			secondary: actions.secondary.filter(a => !fora.has(a.id))
+		};
+	}
+
 	protected abstract prepareEditorActions(editorActions: IToolbarActions): IToolbarActions;
 
 	protected abstract prepareEditorLayoutActions(editorActions: IToolbarActions): IToolbarActions;
